{
  "name": "mpsc-free-mock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:banks": "node --experimental-strip-types scripts/validate-question-banks.mjs",
    "test:content": "node --experimental-strip-types --test scripts/content.test.mjs",
    "test:mizo": "node --experimental-strip-types --test scripts/mizo.test.mjs",
    "test:question-rotation": "node --experimental-strip-types --test scripts/question-rotation.test.mjs",
    "test:guidance": "node --experimental-strip-types --test scripts/guidance.test.mjs",
    "test:exam-simulator": "node --experimental-strip-types --test scripts/exam-simulator.test.mjs",
    "test:lecture": "node --experimental-strip-types --test scripts/lecture.test.mjs scripts/lecture-captions.test.mjs scripts/lecture-progress.test.mjs scripts/jee-course.test.mjs",
    "test": "npm run test:content && npm run test:mizo && npm run test:question-rotation && npm run test:guidance && npm run test:exam-simulator && npm run test:lecture",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate:banks && npm test && npm run lint && npm run typecheck",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
